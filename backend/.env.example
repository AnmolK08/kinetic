# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase Postgres / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kinetic?schema=public"

# Authentication
JWT_SECRET="kinetic_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
